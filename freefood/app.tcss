/* FreeFood TUI Styles */

Screen {
    background: $surface;
}

#content {
    width: 100%;
    height: 1fr;
    padding: 1;
}

.loading {
    text-align: center;
    color: $text-muted;
    height: 100%;
    content-align: center middle;
}

.error {
    text-align: center;
    color: $error;
    height: 100%;
    content-align: center middle;
}
